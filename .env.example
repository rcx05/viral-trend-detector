# =============================================================
# Viral Trend Detector — API Keys Configuration
# Copy this file to .env and fill in your keys
# =============================================================

# ── Reddit API (Free) ──────────────────────────────────────
# Get at: https://www.reddit.com/prefs/apps  → "Create App" → Script
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=viral_trend_detector/1.0 by YourUsername

# ── NewsAPI (Free 100 req/day) ─────────────────────────────
# Get at: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key

# ── YouTube Data API v3 (Free 10,000 units/day) ───────────
# Get at: https://console.cloud.google.com → Enable YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key

# ── Google Trends (pytrends — No key needed) ──────────────
# No API key required. pytrends scrapes Google Trends automatically.

# ── App Settings ──────────────────────────────────────────
CACHE_TTL_SECONDS=300
MAX_HISTORY_DAYS=30
